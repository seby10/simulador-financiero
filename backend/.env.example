DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/simulador_financiero?schema=public"
DIRECT_URL="postgresql://postgres:postgrespassword@localhost:5433/simulador_financiero?schema=public"
PORT=3001
CORS_ORIGIN=http://localhost:3000
# openssl rand -hex 32
ADMIN_API_KEY=

# ───────────────────────── Sesiones ─────────────────────────
# Firma de los access tokens. Mínimo 32 caracteres: openssl rand -hex 32
# Cambiarla invalida todas las sesiones abiertas.
JWT_SECRET=
# Vidas en segundos: access 15 min, refresh 30 días (valores por defecto).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# Cookies: en producción secure se activa solo. Con el frontend en otro dominio
# hace falta COOKIE_SAMESITE=none, que el navegador solo acepta junto a Secure.
COOKIE_SAMESITE=lax
# COOKIE_SECURE=true
# COOKIE_DOMAIN=

# Administrador inicial que crea `pnpm run db:seed`. Sin estas dos variables no
# se crea ninguna cuenta; la contraseña nunca se versiona.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=Administrador

# ───────────────────────── Biometría ─────────────────────────
# Umbrales (0–100) que debe superar cada intento para verificar la identidad, e
# intentos permitidos antes de exigir revisión manual. Un proveedor real se
# calibra con sus propias curvas de error; estos son los valores por defecto.
BIOMETRIC_LIVENESS_MIN=75
BIOMETRIC_MATCH_MIN=75
BIOMETRIC_MAX_ATTEMPTS=3
# faceapi (comparación facial real, por defecto) o simulated (puntajes derivados
# del hash de las imágenes; solo para pruebas y demos sin cámara).
BIOMETRIC_PROVIDER=faceapi

# ───────────────────────── Red ─────────────────────────
# Proxies de confianza para leer la IP real (X-Forwarded-For): la usan el límite
# de peticiones por IP y la auditoría de sesiones. 'loopback' sirve cuando Next
# (rewrites) o nginx corren en la misma máquina. Ver "trust proxy" de Express.
TRUST_PROXY=loopback
