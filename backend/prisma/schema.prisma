generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Todas las tasas se almacenan en porcentaje (16.0000 = 16 %).

enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id             String                   @id @default(uuid())
  /// Normalizado a minúsculas antes de guardar.
  email          String                   @unique
  /// scrypt$N$r$p$salt$hash — nunca la contraseña en claro.
  passwordHash   String
  fullName       String
  /// Cédula. Opcional solo para cuentas creadas por el seed (administradores).
  idNumber       String?                  @unique @db.VarChar(10)
  firstName      String?
  lastName       String?
  phone          String?
  address        String?
  role           UserRole                 @default(CUSTOMER)
  isActive       Boolean                  @default(true)
  sessions       AuthSession[]
  applications   InvestmentApplication[]
  passwordResets BiometricPasswordReset[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
}

/// Cada intento de recuperar la clave por biometría, pase o no. El token en claro
/// solo viaja al cliente; aquí queda su SHA-256 y se invalida al usarlo.
model BiometricPasswordReset {
  id            String    @id @default(uuid())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  passed        Boolean
  livenessScore Decimal   @db.Decimal(5, 2)
  matchScore    Decimal   @db.Decimal(5, 2)
  provider      String
  /// Solo en intentos aprobados.
  tokenHash     String?   @unique
  expiresAt     DateTime?
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Un refresh token vigente por fila. La rotación crea una fila nueva en la misma
/// familia y marca la anterior como rotada; reusar una rotada revoca la familia entera.
model AuthSession {
  id        String    @id @default(uuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// SHA-256 en hex del refresh token; el token en claro solo existe en la cookie.
  tokenHash String    @unique
  /// Cadena de rotación: todas las rotaciones de un login comparten familyId.
  familyId  String
  expiresAt DateTime
  /// Instante en que este token fue canjeado por uno nuevo.
  rotatedAt DateTime?
  /// Instante en que se invalidó (logout, cambio de contraseña o reúso detectado).
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model InstitutionConfig {
  id                  Int      @id @default(1)
  institutionName     String
  ruc                 String   @db.VarChar(13)
  legalRepresentative String
  address             String
  phone               String
  email               String
  logoUrl             String?
  primaryColor        String   @default("#003b70")
  secondaryColor      String   @default("#35b8db")
  accentColor         String   @default("#10b981")
  navbarBgColor       String   @default("#ffffff")
  navbarTextColor     String   @default("#1e293b")
  pageBgColor         String   @default("#f8fafc")
  cardBgColor         String   @default("#ffffff")
  footerBgColor       String   @default("#003b70")
  footerTextColor     String   @default("#e2e8f0")
  heroImageUrl        String?
  heroTitle           String   @default("El respaldo financiero que necesitas.")
  heroSubtitle        String   @default("Crecemos junto a ti. Solicita tu crédito hoy mismo y simula tus pagos de forma transparente.")
  disclaimerText      String
  updatedAt           DateTime @updatedAt
}

model CreditType {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  description        String?
  minAmount          Decimal  @db.Decimal(14, 2)
  maxAmount          Decimal  @db.Decimal(14, 2)
  minTermMonths      Int
  maxTermMonths      Int
  /// Tasa nominal anual (%). La efectiva se deriva: (1 + r/12)^12 - 1
  annualInterestRate Decimal  @db.Decimal(7, 4)
  imageUrl           String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

enum FeeType {
  FIXED_PER_INSTALLMENT
  PERCENTAGE_REMAINING_BALANCE
  PERCENTAGE_INITIAL_AMOUNT
}

model IndirectFee {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  feeType     FeeType
  /// USD si FIXED_PER_INSTALLMENT, porcentaje en los demás casos
  value       Decimal  @db.Decimal(12, 4)
  isMandatory Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InvestmentPlan {
  id                  Int                     @id @default(autoincrement())
  name                String                  @unique
  minAmount           Decimal                 @db.Decimal(14, 2)
  maxAmount           Decimal                 @db.Decimal(14, 2)
  termMinDays         Int
  termMaxDays         Int
  /// Tasa Efectiva Anual (%)
  tea                 Decimal                 @db.Decimal(7, 4)
  allowsMonthlyPayout Boolean                 @default(false)
  requiredDocuments   Json                    @default("[]")
  imageUrl            String?
  applications        InvestmentApplication[]
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
}

enum PayoutMethod {
  AT_MATURITY
  MONTHLY
}

enum ApplicationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

/// La biometría confirma la identidad; aprobar la inversión lo decide un administrador.
enum BiometricStatus {
  /// Aún no hay un intento aprobado y quedan intentos.
  PENDING
  VERIFIED
  /// Se agotaron los intentos: el administrador revisa manualmente.
  FAILED
}

/// Cada intento de verificación biométrica, pase o no. Sirve de rastro de
/// auditoría: quién lo intentó, cuántas veces y con qué puntajes.
model BiometricVerification {
  id            String                @id @default(uuid())
  application   InvestmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  /// 1-based; junto con applicationId no se repite.
  attempt       Int
  /// Porcentajes 0–100.
  livenessScore Decimal               @db.Decimal(5, 2)
  matchScore    Decimal               @db.Decimal(5, 2)
  passed        Boolean
  /// Qué umbral no se alcanzó; null si pasó.
  failureReason String?
  /// Identificador del proveedor que emitió los puntajes.
  provider      String
  createdAt     DateTime              @default(now())

  @@unique([applicationId, attempt])
  @@index([applicationId])
}

model InvestmentApplication {
  id                String                  @id @default(uuid())
  /// Cuenta que creó la solicitud; null en las anteriores a exigir sesión.
  user              User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  applicantFullName String
  applicantIdNumber String                  @db.VarChar(10)
  email             String
  phone             String
  sourceOfFunds     String
  investmentPlan    InvestmentPlan          @relation(fields: [investmentPlanId], references: [id], onDelete: Restrict)
  investmentPlanId  Int
  amount            Decimal                 @db.Decimal(14, 2)
  termDays          Int
  payoutMethod      PayoutMethod
  status            ApplicationStatus       @default(PENDING_REVIEW)
  biometricStatus   BiometricStatus         @default(PENDING)
  /// Puntaje de coincidencia facial del intento que verificó la identidad.
  biometricScore    Decimal?                @db.Decimal(5, 2)
  biometrics        BiometricVerification[]
  documentUrls      Json                    @default("{}")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([status])
  @@index([userId])
}
