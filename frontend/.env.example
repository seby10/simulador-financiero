# ───────────────────────── Backend ─────────────────────────
# A dónde reenvía Next /api y /uploads (rewrites de next.config.ts): es lo que
# acaba llamando el navegador. En producción, la URL de la API en Render.
BACKEND_URL=http://127.0.0.1:3001

# La que usa el servidor de Next al renderizar las páginas. Misma URL + /api.
# Sin ella las páginas intentan hablar con 127.0.0.1 y responden 500.
INTERNAL_API_URL=http://127.0.0.1:3001/api

# ───────────────────────── Opcionales ─────────────────────────
# Hosts extra permitidos al optimizador de imágenes de Next, separados por comas.
# Las URLs de imagen que escriba un administrador deben estar en esta lista.
# IMAGE_HOSTS=cdn.mi-banco.ec

# Orígenes desde los que se abre el sitio en desarrollo además de localhost: la
# IP de la red local o un túnel HTTPS para probar la cámara en el celular.
# ALLOWED_DEV_ORIGINS=192.168.1.50,mi-tunel.trycloudflare.com

# URL pública con la que el escritorio arma el QR del traspaso al celular. Por
# defecto usa la del navegador, que ya es la correcta en producción.
# NEXT_PUBLIC_APP_URL=https://mi-app.vercel.app
